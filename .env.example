# ---------- 复制为 .env 后按需修改 ----------
# Ollama 上游地址（本机默认即可）
OG_OLLAMA_BASE_URL=http://127.0.0.1:11434
OG_DEFAULT_MODEL=qwen2.5:1.5b
OG_REQUEST_TIMEOUT=180

# ---------- 对外服务 ----------
# 留空 = 不鉴权（仅本机开发）。对外开放前一定要填，多个 key 用逗号分隔。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(24))"
OG_API_KEYS=

# 每个 Key 每分钟请求上限，<=0 表示不限
OG_RATE_LIMIT_PER_MINUTE=60

# 单次请求输入字符上限
OG_MAX_INPUT_CHARS=20000

# ---------- 外挂 ----------
OG_ENABLE_TOOLS=true
OG_MAX_TOOL_ROUNDS=4
